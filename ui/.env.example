# Frontend build configuration is independent of backend .env.
# Public values only: Vite exposes these in the browser bundle.
VITE_API_BASE_URL=https://number-api.inboxcloudkit.xyz/api
# Local development: VITE_API_BASE_URL=http://localhost:3030/api
# Legacy REACT_APP_API_BASE_URL or REACT_APP_API_HOST/PROTOCOL remain supported.
