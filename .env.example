# Backend only. Never put secrets in the frontend environment.
API_BASE_URL=https://number-api.inboxcloudkit.xyz/api
# PUBLIC_URL is a legacy fallback, used only when API_BASE_URL is absent.
# PUBLIC_URL=https://number-api.inboxcloudkit.xyz
HOST=0.0.0.0
PORT=3030
# Additional exact origins, comma separated. Domain, www, and localhost dev defaults are included.
CORS_ORIGINS=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_URL takes precedence over REDIS_HOST/PORT/PASSWORD.
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_COMMAND_TIMEOUT_MS=5000
REDIS_RECONNECT_ATTEMPTS=3
CACHE_TTL_SECONDS=43200
BROWSER_MAX_CONCURRENCY=3
BROWSER_TASK_TIMEOUT_MS=60000
BROWSER_NAVIGATION_TIMEOUT_MS=30000
BROWSER_REFRESH_INTERVAL_MS=600000
# Puppeteer installs a matching browser by default. Set this only for a managed browser.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_NO_SANDBOX=false
MAX_PROVIDER_PAGES=50
PROVIDER_RETRIES=2
# PROXY=http://proxy.example:8080

# Optional Cloudflare Tunnel overlay only (see docs/deployment.md).
# Keep both files in a private directory outside the Git checkout.
# NUMBER_API_TUNNEL_CREDENTIALS_FILE=/absolute/private/number-api-tunnel/credentials.json
# NUMBER_API_TUNNEL_CONFIG_FILE=/absolute/private/number-api-tunnel/config.yml
# Set these to the private files' numeric owner/group (id -u and id -g).
# NUMBER_API_TUNNEL_UID=65532
# NUMBER_API_TUNNEL_GID=65532
