{
  "name": "number-api",
  "version": "2.0.0",
  "main": "dist/app.js",
  "description": "Redis-backed Number API for shared public SMS testing inboxes",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kirsh2029/free-otp-api.git"
  },
  "keywords": [
    "otp",
    "puppeteer"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "dev": "tsx watch src/app.ts",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint src tests",
    "check": "npm run lint && npm run build && npm test",
    "build:ui": "npm --prefix ui run build"
  },
  "dependencies": {
    "@fastify/cors": "11.4.1",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "consola": "3.4.2",
    "croner": "11.0.0",
    "dotenv": "18.0.9",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "json-schema-to-ts": "3.1.1",
    "libphonenumber-js": "1.13.15",
    "puppeteer": "25.16.0",
    "puppeteer-cluster": "0.25.0",
    "redis": "6.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.19.0",
  "overrides": {
    "minimatch": "11.0.4"
  }
}
